+++ b/ledger-api/src/main/java/com/gattopiccolo/ledger/threat/vuln/VulnerabilityPrioritizer.java
@@ -0,0 +1,63 @@
+package com.gattopiccolo.ledger.threat.vuln;
+
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Ranks vulnerabilities by real-world risk rather than by CVSS alone.
+ *
+ * <pre>
+ * score = cvss/10 x 40  +  epss x 30  +  20 if known-exploited  +  10 if internet-exposed
+ * score x= 0.4 when the library is not loaded at runtime
+ * </pre>
+ *
+ * Tiers: P1 &gt;= 70 (fix now), P2 &gt;= 45, P3 &gt;= 25, otherwise P4. A teaching
+ * heuristic that demonstrates "prioritisation with runtime context", not an
+ * official formula.
+ */
+public final class VulnerabilityPrioritizer {
+
+    private static final double NOT_LOADED_FACTOR = 0.4;
+
+    public PrioritizedVulnerability prioritize(VulnerabilityFinding v) {
+        double score = v.cvss() / 10.0 * 40.0 + v.epss() * 30.0;
+        StringBuilder why = new StringBuilder();
+        why.append(String.format("CVSS %.1f, EPSS %.0f%%", v.cvss(), v.epss() * 100));
+        if (v.knownExploited()) {
+            score += 20;
+            why.append(", known exploited");
+        }
+        if (v.internetExposed()) {
+            score += 10;
+            why.append(", internet-exposed");
+        }
+        if (!v.loadedAtRuntime()) {
+            score *= NOT_LOADED_FACTOR;
+            why.append(", not loaded at runtime (deprioritised)");
+        } else {
+            why.append(", loaded at runtime");
+        }
+        int rounded = (int) Math.max(0, Math.min(100, Math.round(score)));
+        return new PrioritizedVulnerability(v, rounded, tier(rounded), why.toString());
+    }
+
+    public List<PrioritizedVulnerability> rank(List<VulnerabilityFinding> findings) {
+        return findings.stream()
+                .map(this::prioritize)
+                .sorted(Comparator.comparingInt(PrioritizedVulnerability::priorityScore).reversed())
+                .toList();
+    }
+
+    static String tier(int score) {
+        if (score >= 70) {
+            return "P1 - fix now";
+        }
+        if (score >= 45) {
+            return "P2 - this sprint";
+        }
+        if (score >= 25) {
+            return "P3 - backlog";
+        }
+        return "P4 - monitor";
+    }
+}
