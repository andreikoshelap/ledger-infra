@@ -0,0 +1,20 @@
+package com.gattopiccolo.ledger.threat.vuln;
+
+/**
+ * A known vulnerability in a dependency, with the signals used to prioritise it.
+ *
+ * @param cvss            CVSS base score 0..10 (severity in theory)
+ * @param epss            EPSS probability 0..1 of exploitation in the next 30 days
+ * @param knownExploited  listed in an "actively exploited" catalogue such as CISA KEV
+ * @param loadedAtRuntime the vulnerable library is actually loaded by a running process
+ * @param internetExposed the affected service is reachable from the internet
+ */
+public record VulnerabilityFinding(String cveId,
+                                   String component,
+                                   String version,
+                                   double cvss,
+                                   double epss,
+                                   boolean knownExploited,
+                                   boolean loadedAtRuntime,
+                                   boolean internetExposed) {
+}
diff --git a/ledger-api/src/main/java/com/gattopiccolo/ledger/threat/vuln/VulnerabilityPrioritizer.java b/ledger-api/src/main/java/com/gattopiccolo/ledger/threat/vuln/VulnerabilityPrioritizer.java
new file mode 100644
index 0000000..4cfd275
