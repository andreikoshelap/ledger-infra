+}
+
+.hero {
+  display: flex;
+  justify-content: space-between;
+  align-items: end;
+  gap: 1rem;
+  padding: 1.5rem 1.75rem;
+  border: 1px solid #d6dce8;
+  border-radius: 8px;
+  background: linear-gradient(135deg, #ffffff 0%, #eef4ff 100%);
+}
+
+.hero__eyebrow {
+  margin: 0 0 0.5rem;
+  color: #5f6f88;
+  font-size: 0.85rem;
+  text-transform: uppercase;
+}
+
+.hero__title {
+  margin: 0;
+  font-size: clamp(2rem, 4vw, 3rem);
+  line-height: 1.05;
+  font-weight: 700;
+}
+
+.hero__copy {
+  margin: 0.6rem 0 0;
+  max-width: 42rem;
+  color: #5a677d;
+}
+
+.hero__meta {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(120px, 1fr));
+  gap: 0.75rem;
+  min-width: min(100%, 340px);
+}
+
+.metric {
+  display: grid;
+  gap: 0.35rem;
+  padding: 0.9rem 1rem;
+  border: 1px solid #d6dce8;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.82);
+}
+
+.metric__label {
+  font-size: 0.75rem;
+  text-transform: uppercase;
+  color: #6a7890;
+}
+
+.metric__value {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: #215cff;
+}
+
+.panel {
+  padding: 1.25rem 1.5rem;
+  border: 1px solid #d6dce8;
+  border-radius: 8px;
+  background: #fff;
+}
+
+.section-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 0.75rem;
+  margin-bottom: 1rem;
+}
+
+.section-head h2 {
+  margin: 0;
+  font-size: 1.25rem;
+}
+
+.section-head__hint {
+  color: #5a677d;
+  font-size: 0.9rem;
+}
+
+.section-actions {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+}
+
+.toggle {
+  display: flex;
+  align-items: center;
+  gap: 0.4rem;
+  font-size: 0.9rem;
+  color: #5a677d;
+}
+
+.secondary-button {
+  padding: 0.4rem 0.8rem;
+  border: 1px solid #c3cde0;
+  border-radius: 6px;
+  background: #fff;
+  color: #14213d;
+  cursor: pointer;
+}
+
+.secondary-button:disabled {
+  opacity: 0.6;
+  cursor: default;
+}
+
+.state {
+  margin: 0;
+  color: #5a677d;
+}
+
+.state--error {
+  color: #b42318;
+}
+
+.findings {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 0.75rem;
+}
+
+.finding {
+  display: grid;
+  grid-template-columns: 64px 1fr auto;
+  gap: 1rem;
+  padding: 0.9rem 1rem;
+  border: 1px solid #d6dce8;
+  border-left-width: 6px;
+  border-radius: 8px;
+}
+
+.finding.severity-low { border-left-color: #8aa4d6; }
+.finding.severity-medium { border-left-color: #e0a100; }
+.finding.severity-high { border-left-color: #e5642b; }
+.finding.severity-critical { border-left-color: #b42318; }
