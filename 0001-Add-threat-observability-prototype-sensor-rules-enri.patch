diff --git a/ledger-web/src/app/core/api/security-api.ts b/ledger-web/src/app/core/api/security-api.ts
new file mode 100644
index 0000000..3b7fa79
--- /dev/null
+++ b/ledger-web/src/app/core/api/security-api.ts
@@ -0,0 +1,31 @@
+import { HttpClient } from '@angular/common/http';
+import { inject, Injectable } from '@angular/core';
+import { Observable } from 'rxjs';
+import {
+  Finding,
+  FindingStatus,
+  PrioritizedVulnerability,
+  SecuritySummary,
+} from '../models/security';
+
+@Injectable({ providedIn: 'root' })
+export class SecurityApi {
+  private readonly http = inject(HttpClient);
+  private readonly base = '/api/security';
+
+  listFindings(): Observable<Finding[]> {
+    return this.http.get<Finding[]>(`${this.base}/findings`);
+  }
+
+  updateStatus(id: number, status: FindingStatus): Observable<Finding> {
+    return this.http.post<Finding>(`${this.base}/findings/${id}/status`, { status });
+  }
+
+  summary(): Observable<SecuritySummary> {
+    return this.http.get<SecuritySummary>(`${this.base}/summary`);
+  }
+
+  vulnerabilities(): Observable<PrioritizedVulnerability[]> {
+    return this.http.get<PrioritizedVulnerability[]>(`${this.base}/vulnerabilities`);
+  }
+}
diff --git a/ledger-web/src/app/core/models/security.ts b/ledger-web/src/app/core/models/security.ts
new file mode 100644
index 0000000..a02aac1
--- /dev/null
+++ b/ledger-web/src/app/core/models/security.ts
@@ -0,0 +1,51 @@
+export type Severity = 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';
+export type FindingStatus = 'OPEN' | 'ACKNOWLEDGED' | 'RESOLVED';
+
+/** A deduplicated, enriched and scored security finding. */
+export interface Finding {
+  id: number;
+  ruleId: string;
+  title: string;
+  severity: Severity;
+  riskScore: number;
+  status: FindingStatus;
+  owaspCategory: string | null;
+  attackTactic: string | null;
+  attackTechnique: string | null;
+  actor: string | null;
+  sourceIp: string | null;
+  affectedAccountId: number | null;
+  occurrenceCount: number;
+  firstSeen: string;
+  lastSeen: string;
+  evidence: string | null;
+  intel: string | null;
+}
+
+/** Noise metrics since the backend started. */
+export interface SecuritySummary {
+  rawEvents: number;
+  detections: number;
+  suppressedDuplicates: number;
+  findingsCreated: number;
+  activeFindings: number;
+  noiseReductionPct: number;
+}
+
+export interface VulnerabilityFinding {
+  cveId: string;
+  component: string;
+  version: string;
+  cvss: number;
+  epss: number;
+  knownExploited: boolean;
+  loadedAtRuntime: boolean;
+  internetExposed: boolean;
+}
+
+export interface PrioritizedVulnerability {
+  finding: VulnerabilityFinding;
+  priorityScore: number;
+  tier: string;
+  rationale: string;
+}
